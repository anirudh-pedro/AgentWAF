# ==============================================================================
# Agent WAF - Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="Agent WAF"
APP_VERSION="1.0.0"
APP_ENV="development" # development | staging | production | test
DEBUG=true
API_V1_STR="/api/v1"

# Middleware & Tracing Configuration
REQUEST_ID_HEADER="X-Request-ID"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security & CORS
# JSON array or comma-separated string
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Configuration
# Default to SQLite async for local dev; easily switched to Neon/PostgreSQL in production
DATABASE_URL="sqlite+aiosqlite:///./agent_waf.db"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Logging Configuration
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json" # json | text
