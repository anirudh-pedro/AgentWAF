# ==============================================================================
# Agent WAF - Enterprise Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="Agent WAF"
APP_DESCRIPTION="Enterprise-grade Agent Web Application Firewall"
APP_VERSION="1.0.0"
ENVIRONMENT="production" # development | staging | production | test
DEBUG=false

# Server Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Middleware & Tracing Configuration
REQUEST_ID_HEADER="X-Request-ID"

# Database Configuration (PostgreSQL / Neon Serverless)
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql+asyncpg://user:password@ep-your-db.aws.neon.tech/neondb?sslmode=require"
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Logging & Observability Configuration
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json" # json | text

# Security, CORS & Rate Limiting
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://your-domain.com"]
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# WAF Policy Engine Settings
SHADOW_MODE=false
FAIL_CLOSED=true
RISK_THRESHOLD=0.50

# Gmail SMTP Integration & Email Security
GMAIL_EMAIL=""
GMAIL_APP_PASSWORD=""
ALLOWED_EMAIL_DOMAINS="gmail.com,company.com,enterprise.internal,example.com"

