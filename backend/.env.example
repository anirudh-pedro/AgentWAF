# ==============================================================================
# Agent WAF - Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="Agent WAF"
APP_DESCRIPTION="Enterprise-grade Agent Web Application Firewall"
APP_VERSION="1.0.0"
ENVIRONMENT="development" # development | staging | production | test
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Middleware & Tracing Configuration
REQUEST_ID_HEADER="X-Request-ID"

# Database Configuration
# Default to SQLite async for local dev; easily switched to Neon/PostgreSQL in production
DATABASE_URL="sqlite+aiosqlite:///./agent_waf.db"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Logging Configuration
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json" # json | text

# Security & CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Future WAF Engine Settings
SHADOW_MODE=false
REQUEST_TIMEOUT=30
RATE_LIMIT_WINDOW=60
